# Copy to .env and fill in ONE provider block.
# LLM_PROVIDER = openai | litellm | azure | ollama | mock   (mock = offline test without API key)
LLM_PROVIDER=openai

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- LiteLLM proxy ---
LITELLM_API_BASE=http://localhost:4000
LITELLM_KEY=
LITELLM_MASTER_KEY=
LITELLM_DEFAULT_MODEL=gpt-4o-mini

# --- Azure OpenAI / AI Foundry ---
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-10-21

# --- Ollama (model with tool calling, e.g. qwen2.5:7b) ---
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b

# leave empty for reasoning models that reject a temperature
LLM_TEMPERATURE=0

# --- Registry / network ---
REGISTRY_URL=http://127.0.0.1:8000
REGISTRY_API_KEY=change-me-shared-secret
MCP_INVENTORY_URL=http://127.0.0.1:8200/mcp
HEARTBEAT_SECONDS=15
REGISTRY_TTL_SECONDS=45
A2A_TIMEOUT_SECONDS=240
APPROVAL_THRESHOLD_EUR=10000
